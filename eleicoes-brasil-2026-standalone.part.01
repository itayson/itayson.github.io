candidate-footer { flex-direction: column; gap: 4px; }
  .state-row { grid-template-columns: 44px 1fr; }
  .state-progress-text { grid-column: 2; }
  .elected-grid { grid-template-columns: 1fr; }
  .footer { flex-direction: column; }
}
@media (max-width: 430px) {
  .summary-grid { grid-template-columns: 1fr; }
}

/* v3 — mapa geográfico, painel nacional e rankings */
.button-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.map-loading-text { fill: var(--muted); font: 700 14px system-ui, sans-serif; }
.geo-state { cursor: pointer; outline: none; }
.geo-state path, .map-municipality path { fill: var(--panel-2); stroke: color-mix(in srgb, var(--line) 88%, transparent); stroke-width: 1.1; vector-effect: non-scaling-stroke; transition: fill .16s, stroke .16s, opacity .16s; }
.geo-state:hover path, .geo-state:focus path, .map-municipality:hover path, .map-municipality:focus path { stroke: var(--accent); stroke-width: 2.2; }
.geo-state.selected path, .map-municipality.selected path { stroke: var(--accent); stroke-width: 3; }
.geo-state[data-level="v0"] path, .map-municipality[data-level="v0"] path { fill: var(--panel-2); }
.geo-state[data-level="v1"] path, .map-municipality[data-level="v1"] path { fill: color-mix(in srgb, var(--accent) 16%, var(--panel-2)); }
.geo-state[data-level="v2"] path, .map-municipality[data-level="v2"] path { fill: color-mix(in srgb, var(--accent) 28%, var(--panel-2)); }
.geo-state[data-level="v3"] path, .map-municipality[data-level="v3"] path { fill: color-mix(in srgb, var(--accent) 42%, var(--panel-2)); }
.geo-state[data-level="v4"] path, .map-municipality[data-level="v4"] path { fill: color-mix(in srgb, var(--accent) 58%, var(--panel-2)); }
.geo-state[data-level="v5"] path, .map-municipality[data-level="v5"] path { fill: color-mix(in srgb, var(--accent) 78%, var(--panel-2)); }
.map-municipality { cursor: pointer; outline: none; }
.map-municipality path { stroke-width: .55; }

.national-card, .ranking-card { overflow: hidden; }
.national-section { padding: 18px 24px 4px; }
.national-section h3, .national-split h3, .ranking-pane h3 { margin: 0; font-size: 18px; }
.national-president { display: grid; gap: 8px; margin-top: 12px; }
.national-split { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding: 20px 24px 24px; }
.national-split > section { min-width: 0; }
.territory-grid { display: grid; gap: 8px; margin-top: 12px; max-height: 720px; overflow: auto; padding-right: 2px; }
.territory-card { display: grid; grid-template-columns: 72px minmax(0,1fr) auto; align-items: center; gap: 12px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 14px; background: var(--panel-solid); }
.territory-card > div strong, .territory-card > div small, .territory-card p b, .territory-card p span { display: block; }
.territory-card > div strong { font-size: 18px; }
.territory-card > div small, .territory-card p span { color: var(--muted); font-size: 11px; margin-top: 2px; }
.territory-card p { margin: 0; min-width: 0; }
.territory-card p b { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.territory-card em { font-style: normal; color: var(--accent); font-size: 10px; font-weight: 900; letter-spacing: .06em; text-transform: uppercase; }
.territory-card.muted { color: var(--muted); }

.inline-field { min-width: 280px; }
.ranking-grid { display: grid; grid-template-columns: 1fr 1fr; }
.ranking-pane { min-width: 0; border-top: 1px solid var(--line); }
.ranking-pane + .ranking-pane { border-left: 1px solid var(--line); }
.subhead { display: flex; justify-content: space-between; gap: 14px; align-items: center; padding: 18px 20px 12px; }
.subhead p { margin: 4px 0 0; color: var(--muted); font-size: 12px; }
.compact-status { padding: 10px 20px; font-size: 12px; }
.ranking-list { display: grid; max-height: 760px; overflow: auto; }
.ranking-row { display: grid; grid-template-columns: 36px minmax(0,1fr) auto; align-items: center; gap: 12px; padding: 12px 18px; border-top: 1px solid var(--line); }
.ranking-row > b { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 10px; background: var(--panel-2); font-size: 12px; }
.ranking-row span strong, .ranking-row span small { display: block; }
.ranking-row span strong { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ranking-row span small { color: var(--muted); margin-top: 2px; font-size: 11px; }
.ranking-row em { font-style: normal; font-weight: 900; font-size: 16px; }
.ranking-row.muted { color: var(--muted); }

@media (max-width: 980px) {
  .national-split, .ranking-grid { grid-template-columns: 1fr; }
  .ranking-pane + .ranking-pane { border-left: 0; border-top: 1px solid var(--line); }
}
@media (max-width: 680px) {
  .button-row { width: 100%; }
  .button-row > button { flex: 1 1 auto; }
  .inline-field { min-width: 0; width: 100%; }
  .subhead { align-items: stretch; flex-direction: column; }
  .territory-card { grid-template-columns: 56px minmax(0,1fr); }
  .territory-card em { grid-column: 2; }
  .ranking-row { grid-template-columns: 32px minmax(0,1fr) auto; padding-inline: 12px; }
}

</style>
</head>
<body>
  <a class="skip-link" href="#main">Ir para o conteúdo</a>

  <header class="topbar">
    <div class="brand-wrap">
      <div class="brand-mark" aria-hidden="true">26</div>
      <div>
        <strong>Eleições Brasil</strong>
        <span>Apuração 2026 · dados oficiais do TSE</span>
      </div>
    </div>
    <div class="top-actions">
      <span id="connectionBadge" class="status-badge neutral">Conectando…</span>
      <button id="themeToggle" class="icon-button" type="button" title="Alternar tema" aria-label="Alternar tema">◐</button>
      <a class="tse-link" href="https://resultados.tse.jus.br/" target="_blank" rel="noopener noreferrer">TSE ↗</a>
    </div>
  </header>

  <main id="main" class="shell">
    <section class="hero">
      <div>
        <div class="eyebrow"><span class="live-dot" aria-hidden="true"></span><span id="liveLabel">Acompanhamento em tempo real</span></div>
        <h1>Apuração eleitoral, sem ruído.</h1>
        <p>Resultados, evolução da totalização, mapa por UF e consultas municipais em uma interface única. O painel não faz projeções: exibe os dados publicados pela Justiça Eleitoral.</p>
      </div>
      <div class="hero-status">
        <span id="dataSourceBadge" class="status-badge neutral">Fonte direta</span>
        <strong id="scopeLabel">Brasil · Presidente</strong>
        <small>Última atualização: <span id="updatedAt">—</span></small>
      </div>
    </section>

    <section class="card controls" aria-label="Filtros da consulta">
      <div class="field">
        <label for="turno">Turno</label>
        <select id="turno">
          <option value="1">1º turno</option>
          <option value="2">2º turno</option>
        </select>
      </div>
      <div class="field">
        <label for="cargo">Cargo</label>
        <select id="cargo">
          <option value="1">Presidente</option>
          <option value="3">Governador</option>
          <option value="5">Senador</option>
          <option value="6">Deputado Federal</option>
          <option value="7">Deputado Estadual</option>
          <option value="8">Deputado Distrital</option>
        </select>
      </div>
      <div class="field">
        <label for="abrangencia">Abrangência</label>
        <select id="abrangencia">
          <option value="br">Brasil</option>
          <option value="uf">Estado</option>
          <option value="municipio">Município</option>
        </select>
      </div>
      <div class="field" id="ufField">
        <label for="uf">UF</label>
        <select id="uf"></select>
      </div>
      <div class="field hidden" id="municipioField">
        <label for="municipio">Município</label>
        <select id="municipio" disabled><option value="">Carregando municípios…</option></select>
      </div>
      <button id="refreshButton" class="primary-button" type="button">Atualizar agora</button>
    </section>

    <div id="notice" class="notice hidden" role="status"></div>

    <nav class="tabs" aria-label="Seções do painel">
      <button class="tab-button active" type="button" data-tab="apurar" aria-selected="true">Apuração</button>
      <button class="tab-button" type="button" data-tab="mapa" aria-selected="false">Mapa</button>
      <button class="tab-button" type="button" data-tab="nacional" aria-selected="false">Painel nacional</button>
      <button class="tab-button" type="button" data-tab="rankings" aria-selected="false">Rankings</button>
      <button class="tab-button" type="button" data-tab="evolucao" aria-selected="false">Evolução</button>
      <button class="tab-button" type="button" data-tab="eleitos" aria-selected="false">Eleitos</button>
    </nav>

    <section id="tab-apurar" class="tab-panel active">
      <div class="summary-grid">
        <article class="metric-card">
          <span>Seções totalizadas</span>
          <strong id="pctSecoes">—</strong>
          <div class="progress" aria-hidden="true"><div id="pctSecoesBar" class="progress-bar"></div></div>
          <small id="secoesDetail">—</small>
        </article>
        <article class="metric-card">
          <span>Eleitorado</span>
          <strong id="eleitorado">—</strong>
          <small id="comparecimento">Comparecimento: —</small>
        </article>
        <article class="metric-card">
          <span>Votos válidos</span>
          <strong id="votosValidos">—</strong>
          <small id="votosTotais">Total computado: —</small>
        </article>
        <article class="metric-card">
          <span>Brancos + nulos</span>
          <strong id="brancosNulos">—</strong>
          <small id="brancosNulosPct">—</small>
        </article>
      </div>

      <section class="card results">
        <header class="section-head">
          <div>
            <p class="section-kicker">Resultado publicado</p>
            <h2 id="resultTitle">Candidatos</h2>
            <p id="resultSubtitle">Ordenados pelos votos válidos informados pelo TSE.</p>
          </div>
          <label class="search-box">
            <span class="sr-only">Pesquisar candidato</span>
            <input id="searchInput" type="search" placeholder="Nome, número ou partido">
          </label>
        </header>

        <div id="loadingState" class="loading-state">
          <span class="spinner" aria-hidden="true"></span>
          <span>Consultando dados oficiais…</span>
        </div>
        <div id="emptyState" class="empty-state hidden">
          <strong>Nenhum dado disponível.</strong>
          <p>A consulta pode ainda não ter sido publicada pelo TSE ou não possuir candidatos para esta abrangência.</p>
        </div>
        <div id="candidateList" class="candidate-list"></div>
      </section>
    </section>

    <section id="tab-mapa" class="tab-panel">
      <div class="two-column-layout">
        <section class="card map-card">
          <header class="section-head compact">
            <div>
              <p class="section-kicker">Território brasileiro</p>
              <h2>Mapa geográfico interativo</h2>
              <p>Limites estaduais reais; a visão municipal é carregada sob demanda para a UF selecionada.</p>
            </div>
            <div class="button-row">
              <button id="showStatesMapButton" class="secondary-button" type="button">Estados</button>
              <button id="showMunicipalMapButton" class="secondary-button" type="button">Municípios da UF</button>
              <button id="compareStatesButton" class="secondary-button" type="button">Atualizar 27 UFs</button>
            </div>
          </header>
          <div class="map-legend">
            <span id="mapModeStatus">Mapa: carregando geometria…</span>
            <span><i class="legend-box low"></i> menor valor</span>
            <span><i class="legend-box high"></i> maior valor</span>
          </div>
          <div class="map-wrap">
            <svg id="brazilMap" class="brazil-map" viewBox="0 0 760 700" role="img" aria-label="Mapa geográfico interativo do Brasil"></svg>
          </div>
        </section>

        <aside class="card state-inspector">
          <p class="section-kicker">UF selecionada</p>
          <h2 id="mapStateName">Selecione um estado</h2>
          <div id="mapStateMeta" class="inspector-meta">O painel exibirá o andamento da totalização e os candidatos mais votados na UF.</div>
          <div id="mapStateCandidates" class="mini-ranking"></div>
          <button id="openStateButton" class="primary-button full hidden" type="button">Abrir esta UF</button>
        </aside>
      </div>

      <section class="card compare-card">
        <header class="section-head compact">
          <div>
            <p class="section-kicker">Comparação estadual</p>
            <h2>Panorama das 27 UFs</h2>
            <p>Para Presidente, compara os mesmos candidatos entre as UFs. Para cargos estaduais, mostra o mais votado de cada estado.</p>
          </div>
          <label class="search-box">
            <span class="sr-only">Filtrar UFs</span>
            <input id="stateSearchInput" type="search" placeholder="Filtrar por UF ou candidato">
          </label>
        </header>
        <div id="stateCompareStatus" class="inline-status">Clique em “Atualizar 27 UFs” para carregar a comparação.</div>
        <div id="stateComparison" class="state-comparison"></div>
      </section>
    </section>

    <section id="tab-nacional" class="tab-panel">
      <section class="card national-card">
        <header class="section-head compact">
          <div>
            <p class="section-kicker">Visão Brasil</p>
            <h2>Presidência, Governadores e Senado</h2>
            <p>Resumo nacional dos arquivos publicados. Para Governador e Senado, cada UF é exibida separadamente; o painel não transforma liderança parcial em projeção.</p>
          </div>
          <button id="loadNationalButton" class="primary-button" type="button">Carregar painel nacional</button>
        </header>
        <div id="nationalStatus" class="inline-status">Clique em “Carregar painel nacional” para consultar os dados.</div>
        <div class="national-section">
          <h3>Presidente · Brasil</h3>
          <div id="nationalPresident" class="national-president"></div>
        </div>
        <div class="national-split">
          <section>
            <h3>Governador · 27 UFs</h3>
            <div id="nationalGovernors" class="territory-grid"></div>
          </section>
          <section>
            <h3>Senado · 27 UFs</h3>
            <div id="nationalSenate" class="territory-grid"></div>
          </section>
        </div>
      </section>
    </section>

    <section id="tab-rankings" class="tab-panel">
      <section class="card ranking-card">
        <header class="section-head compact">
          <div>
            <p class="section-kicker">Comparação territorial</p>
            <h2>Ranking por UF e município</h2>
            <p>Escolha um candidato da consulta atual. O ranking municipal é carregado em lotes pequenos para reduzir pressão sobre a infraestrutura do TSE.</p>
          </div>
          <label class="field inline-field">
            <span>Candidato</span>
            <select id="rankingCandidate"></select>
          </label>
        </header>
        <div class="ranking-grid">
          <section class="ranking-pane">
            <div class="subhead">
              <div><h3>Unidades da Federação</h3><p>Percentual do candidato em cada UF.</p></div>
              <button id="loadStateRankingButton" class="secondary-button" type="button">Carregar UFs</button>
            </div>
            <div id="stateRankingStatus" class="inline-status compact-status">Aguardando consulta.</div>
            <div id="stateRanking" class="ranking-list"></div>
          </section>
          <section class="ranking-pane">
            <div class="subhead">
              <div><h3>Municípios da UF</h3><p>Ranking progressivo da UF atualmente selecionada.</p></div>
              <div class="button-row">
                <button id="loadMunicipalBatchButton" class="secondary-button" type="button">Carregar +30</button>
                <button id="loadAllMunicipalButton" class="secondary-button" type="button">Carregar todos</button>
                <button id="stopMunicipalButton" class="secondary-button hidden" type="button">Parar</button>
              </div>
            </div>
            <div id="municipalRankingStatus" class="inline-status compact-status">Selecione uma UF e um candidato.</div>
            <div id="municipalRanking" class="ranking-list"></div>
          </section>
        </div>
      </section>
    </section>

    <section id="tab-evolucao" class="tab-panel">
      <section class="card chart-card">
        <header class="section-head compact">
          <div>
            <p class="section-kicker">Histórico da sessão</p>
            <h2>Evolução da totalização</h2>
            <p>Os pontos são salvos no navegador sempre que o TSE publica uma atualização. Com KV no Worker, o histórico pode ser compartilhado entre visitantes.</p>
          </div>
          <button id="clearHistoryButton" class="secondary-button" type="button">Limpar histórico local</button>
        </header>
        <div class="chart-shell">
          <canvas id="sectionsChart" height="320" aria-label="Gráfico de evolução das seções totalizadas"></canvas>
          <div id="sectionsChartEmpty" class="chart-empty hidden">Ainda não há pontos suficientes para desenhar a evolução.</div>
        </div>
      </section>

      <section class="card chart-card">
        <header class="section-head compact">
          <div>
            <p class="section-kicker">Votos válidos</p>
            <h2>Evolução dos candidatos</h2>
            <p>Mostra os candidatos mais votados da consulta atual ao longo das atualizações armazenadas.</p>
          </div>
        </header>
        <div id="candidateC